{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and BookMyShow preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "quikPayBalance": { "type": "number" },
        "bmsRewardsPoints": { "type": "number" },
        "city": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Booking": {
      "title": "Ticket Booking",
      "description": "Movie and event ticket reservations made by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bookingRef": { "type": "string" },
        "movieTitle": { "type": "string" },
        "moviePoster": { "type": "string" },
        "language": { "type": "string" },
        "format": { "type": "string" },
        "theaterName": { "type": "string" },
        "screenName": { "type": "string" },
        "showDate": { "type": "string" },
        "showTime": { "type": "string" },
        "seats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ticketCount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "foodItems": {
          "type": "array",
          "items": { "type": "object" }
        },
        "bookingTime": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled"] },
        "qrCodeData": { "type": "string" }
      },
      "required": ["id", "userId", "bookingRef", "movieTitle", "theaterName", "seats", "totalAmount"]
    },
    "WatchlistItem": {
      "title": "Watchlist Item",
      "description": "User bookmarked movies and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "movieId": { "type": "string" },
        "movieTitle": { "type": "string" },
        "posterUrl": { "type": "string" },
        "genre": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ratingScore": { "type": "number" },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "movieId", "movieTitle"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "entity": "User",
      "description": "User profile documents"
    },
    "users/{userId}/bookings/{bookingId}": {
      "entity": "Booking",
      "description": "User bookings"
    },
    "users/{userId}/watchlist/{watchlistId}": {
      "entity": "WatchlistItem",
      "description": "User saved/interested movies"
    }
  }
}
